<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browserRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true">

        <!-- Top Toolbar: Back/Forward + Rounded Address Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="8dp"
            android:padding="0dp"
            android:gravity="center_vertical">

            <!-- Back/Forward buttons -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back"
                android:padding="10dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_forward"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_forward"
                android:padding="10dp"
                android:visibility="gone" />

            <!-- Rounded Address Bar (ClintBrowser style) -->
            <FrameLayout
                android:id="@+id/addressBarContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:padding="0dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="4dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">

                        <!-- Lock/Info icon -->
                        <ImageView
                            android:id="@+id/ivSiteSecurity"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_lock_lock"
                            android:contentDescription="@string/site_security"
                            android:tint="?attr/colorOnSurfaceVariant" />

                        <!-- Search/URL field -->
                        <androidx.appcompat.widget.SearchView
                            android:id="@+id/searchBox"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:iconifiedByDefault="false"
                            android:queryHint="@string/hint_url_or_search"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurfaceVariant"
                            app:iconifiedByDefault="false" />

                        <!-- Tab counter badge -->
                        <TextView
                            android:id="@+id/tvTabCount"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_tab_count_badge"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/md_theme_onPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>
        </LinearLayout>

        <!-- WebView container -->
        <FrameLayout
            android:id="@+id/webViewContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Fullscreen video overlay (WebChromeClient.onShowCustomView) -->
        <FrameLayout
            android:id="@+id/fullscreenVideoContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:visibility="gone" />

        <!-- Floating Video Download Pill (icon-only circular, draggable) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnFloatingDownload"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="80dp"
            android:src="@drawable/ic_download"
            android:contentDescription="@string/action_download"
            app:backgroundTint="?attr/colorPrimary"
            app:tint="@color/md_theme_onPrimary"
            app:elevation="6dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Bottom Navigation Bar (3 tabs: Browser, Downloader, Vault) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="?attr/colorOnSurfaceVariant"
        app:itemTextColor="?attr/colorOnSurfaceVariant"
        app:labelVisibilityMode="labeled"
        app:itemRippleColor="@color/md_theme_primary" />

</LinearLayout>